# Copy to android/keystore.properties (git-ignored) and fill in. NEVER commit the real file or the keystore.
# Create an upload key once (keep the .jks and its passwords in a password manager / CI secret store, back it up):
#   keytool -genkeypair -v -storetype PKCS12 -keystore weride-upload.jks -alias weride-upload \
#           -keyalg RSA -keysize 2048 -validity 10000
# The same four values can instead be Gradle properties or environment variables named WERIDE_RELEASE_<KEY>.
# A relative STORE_FILE is resolved against android/. Prefer enrolling in Play App Signing so this is only the UPLOAD key.
STORE_FILE=/absolute/path/outside/the/repo/weride-upload.jks
STORE_PASSWORD=
KEY_ALIAS=weride-upload
KEY_PASSWORD=
