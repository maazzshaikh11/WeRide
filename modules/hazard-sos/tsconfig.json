{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react",
    "baseUrl": ".",
    "paths": {
      "react-native": ["./node_modules/react-native/types/index.d.ts"],
      "@app/*": ["../../app/src/*"],
      "@contracts/*": ["../../contracts/*"],
      "@tracking/*": ["../tracking/src/*"],
      "@hazard/*": ["../hazard-sos/src/*"],
      "@routing/*": ["../routing-eta/src/*"],
      "@flvoice/*": ["../fl-voice/src/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "outDir": "dist"
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules"]
}
